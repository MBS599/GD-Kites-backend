DATABASE_URL=postgresql://gdkite:gdkite@localhost:5433/gdkite_api?schema=public
# Long random strings, different from each other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Comma-separated OAuth client IDs whose Google ID tokens are accepted (web/server, Android, iOS)
GOOGLE_CLIENT_ID=
PORT=3000

NODE_ENV=development
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Development only: enables POST /api/v1/auth/dev-login for seeded accounts. Refused in production.
ALLOW_DEV_LOGIN=true
# Emails promoted to ADMIN on first Google sign-in (comma-separated)
BOOTSTRAP_ADMIN_EMAILS=

# Reverse geocoding (map point → address). With a key, Google Geocoding is used;
# otherwise OpenStreetMap Nominatim (free, 1 req/s, results cached). Use Google or a
# self-hosted Nominatim for production traffic.
GOOGLE_MAPS_API_KEY=
GEOCODER_USER_AGENT=GDKiteCenter/1.0 (support@gdkitecenter.in)

PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*
HUB_LAT=18.4866
HUB_LNG=73.8656

# Messaging: WhatsApp + Firebase push notifications.
# wwebjs   = WhatsApp from a linked phone (whatsapp-web.js, unofficial, free): scan the QR in Admin → Settings.
# whatsapp = official WhatsApp Cloud API (fill WHATSAPP_* below).
# log      = development: messages only written to the server log.
MESSAGING_PROVIDER=log
WWEBJS_SESSION_DIR=.wwebjs_auth
WWEBJS_MIN_GAP_MS=3000
# Official WhatsApp Cloud API (only for MESSAGING_PROVIDER=whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_LANG=en
WHATSAPP_API_VERSION=v22.0
# Webhook for delivered/read receipts (optional): app secret from Meta app settings,
# verify token = any random string you also enter in the Meta webhook setup.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Push notifications: path to (or JSON of) the Firebase service-account key. Empty = push off.
FIREBASE_SERVICE_ACCOUNT=
